# ============================================================
# Lessonaza Backend - Beta Environment
# ============================================================
# Beta server (codenavi): Docker Compose with PostgreSQL
# Usage: cp .env.beta .env (on beta server)

# === Database (PostgreSQL — beta) ===
DATABASE_URL=postgresql+asyncpg://lessonaza:lessonaza@db:5432/lessonaza_beta
DATABASE_ECHO=false

# === JWT ===
JWT_SECRET_KEY=<REPLACE_WITH_BETA_SECRET>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# === OAuth - Google ===
GOOGLE_CLIENT_ID=<REPLACE>
GOOGLE_CLIENT_SECRET=<REPLACE>

# === OAuth - Kakao ===
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# === OAuth - Apple ===
APPLE_CLIENT_ID=com.lessonaza.app
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=

# === Vultr Object Storage ===
VULTR_STORAGE_ENDPOINT=https://sgp1.vultrobjects.com
VULTR_STORAGE_ACCESS_KEY=<REPLACE>
VULTR_STORAGE_SECRET_KEY=<REPLACE>
VULTR_STORAGE_BUCKET=lessonaza-recordings

# === CORS ===
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# === i18n ===
DEFAULT_LOCALE=ko
SUPPORTED_LOCALES=["ko","en","ja"]

# === Server ===
ENVIRONMENT=beta
DEBUG=true

# === Redis ===
REDIS_URL=redis://redis:6379/0

# === SMS OTP (#1142) ===
# Beta/QA only: with SMS_USE_MOCK=true no real SMS is sent, so enabling this logs the
# issued OTP to the server log for QA to read. NEVER set true in production.
SMS_MOCK_LOG_CODES=true

# --- Solapi 실발송 전환 (#1179) ---
# 자격증명 발급 후 아래 4줄을 채우고 SMS_USE_MOCK=false 로 전환한다.
# SMS_USE_MOCK=false 인데 자격증명이 비어 있으면 부팅이 거부된다 (fail-fast).
# 발신번호는 Solapi 콘솔에 사전 등록된 번호만 사용 가능.
# SMS_USE_MOCK=false
# SMS_API_KEY=<REPLACE_SOLAPI_API_KEY>
# SMS_API_SECRET=<REPLACE_SOLAPI_API_SECRET>
# SMS_SENDER_NUMBER=<REPLACE_REGISTERED_SENDER_NUMBER>
