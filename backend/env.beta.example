# ============================================================
# Lessonaza Backend - Beta Environment Variables
# ============================================================
# Copy this file to .env.beta on the server and fill in values.
# NEVER commit .env.beta with real secrets to git.

# Database (separate DB from production)
POSTGRES_USER=lessonaza_beta
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=lessonaza_beta
DATABASE_URL=postgresql+asyncpg://lessonaza_beta:<change-me>@postgres:5432/lessonaza_beta

# JWT
JWT_SECRET_KEY=<change-me-beta-secret>

# Google OAuth (same Cloud Console project as production)
GOOGLE_CLIENT_ID=<your-google-web-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Environment
ENVIRONMENT=beta
DEBUG=true
