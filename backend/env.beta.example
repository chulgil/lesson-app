# ============================================================
# Lessonaza Backend - Beta Environment Variables
# ============================================================
# Copy this file to .env.beta on the server and fill in values.
# NEVER commit .env.beta with real secrets to git.

# Database (separate DB from production)
POSTGRES_USER=lessonaza_beta
POSTGRES_PASSWORD=<change-me>
POSTGRES_DB=lessonaza_beta
DATABASE_URL=postgresql+asyncpg://lessonaza_beta:<change-me>@postgres:5432/lessonaza_beta

# JWT
JWT_SECRET_KEY=<change-me-beta-secret>

# Google OAuth (same Cloud Console project as production)
GOOGLE_CLIENT_ID=<your-google-web-client-id>
GOOGLE_CLIENT_SECRET=<your-google-client-secret>

# Environment
ENVIRONMENT=beta
DEBUG=true

# SMS OTP (#1142) — beta/QA only
# With SMS_USE_MOCK=true no real SMS is sent, so enabling this logs the issued OTP to
# the server log for QA to read. NEVER set true in production.
SMS_MOCK_LOG_CODES=true

# --- Solapi 실발송 전환 (#1179) ---
# 자격증명 발급 후 아래 4줄을 채우고 SMS_USE_MOCK=false 로 전환한다.
# SMS_USE_MOCK=false 인데 자격증명이 비어 있으면 부팅이 거부된다 (fail-fast).
# 발신번호는 Solapi 콘솔에 사전 등록된 번호만 사용 가능.
# SMS_USE_MOCK=false
# SMS_API_KEY=<REPLACE_SOLAPI_API_KEY>
# SMS_API_SECRET=<REPLACE_SOLAPI_API_SECRET>
# SMS_SENDER_NUMBER=<REPLACE_REGISTERED_SENDER_NUMBER>
