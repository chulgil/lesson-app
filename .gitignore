# =============================================================================
# .gitignore - lesson-app (Monorepo: docs + backend + frontend)
# =============================================================================

# -----------------------------------------------------------------------------
# Firebase / Secrets (절대 커밋 금지)
# -----------------------------------------------------------------------------
backend/keys/
**/firebase-service-account*.json
**/serviceAccountKey*.json
**/GoogleService-Info.plist
**/google-services.json

# -----------------------------------------------------------------------------
# macOS
# -----------------------------------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# -----------------------------------------------------------------------------
# Frontend (Flutter/Dart)
# -----------------------------------------------------------------------------
frontend/.dart_tool/
frontend/.flutter-plugins
frontend/.flutter-plugins-dependencies
frontend/.packages
frontend/.pub-cache/
frontend/.pub/
frontend/build/
frontend/.metadata

# Android
frontend/android/**/gradle-wrapper.jar
frontend/android/.gradle
frontend/android/captures/
frontend/android/gradlew
frontend/android/gradlew.bat
frontend/android/local.properties
frontend/android/**/GeneratedPluginRegistrant.*
frontend/android/key.properties
*.jks

# iOS/XCode
frontend/ios/**/*.mode1v3
frontend/ios/**/*.mode2v3
frontend/ios/**/*.moved-aside
frontend/ios/**/*.pbxuser
frontend/ios/**/*.perspectivev3
frontend/ios/**/*sync/
frontend/ios/**/.sconsign.dblite
frontend/ios/**/.tags*
frontend/ios/**/.vagrant/
frontend/ios/**/DerivedData/
frontend/ios/**/Icon?
frontend/ios/**/Pods/
frontend/ios/**/.symlinks/
frontend/ios/**/profile
frontend/ios/**/xcuserdata
frontend/ios/.generated/
frontend/ios/Flutter/.last_build_id
frontend/ios/Flutter/App.framework
frontend/ios/Flutter/Flutter.framework
frontend/ios/Flutter/Flutter.podspec
frontend/ios/Flutter/Generated.xcconfig
frontend/ios/Flutter/ephemeral
frontend/ios/Flutter/app.flx
frontend/ios/Flutter/app.zip
frontend/ios/Flutter/flutter_assets/
frontend/ios/ServiceDefinitions.json
frontend/ios/Runner/GeneratedPluginRegistrant.*

# Swift Package Manager (Xcode 자동 생성, 사용자별)
frontend/ios/**/xcshareddata/swiftpm/
frontend/macos/**/xcshareddata/swiftpm/

# macOS
frontend/macos/Flutter/GeneratedPluginRegistrant.swift
frontend/macos/Flutter/ephemeral

# -----------------------------------------------------------------------------
# Backend (Python/FastAPI)
# -----------------------------------------------------------------------------
backend/.venv/
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc
backend/**/*.pyc
backend/.pytest_cache/
backend/.mypy_cache/
backend/.ruff_cache/
backend/.coverage
backend/htmlcov/
backend/*.egg-info/
backend/dist/
backend/build/

# Environment files
backend/.env
backend/.env.local
backend/.env.*.local

# -----------------------------------------------------------------------------
# IDE
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.iml

# -----------------------------------------------------------------------------
# Test & Coverage
# -----------------------------------------------------------------------------
coverage/
htmlcov/
*.lcov

# -----------------------------------------------------------------------------
# Logs
# -----------------------------------------------------------------------------
*.log
frontend/logs/

# -----------------------------------------------------------------------------
# Miscellaneous
# -----------------------------------------------------------------------------
*.class
*.swp
.atom/
.buildlog/
.history
.svn/

# Claude local settings
.claude/settings.local.json
backend/test.db
.serena/project.yml
